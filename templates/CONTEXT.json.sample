{
  "project_name": "My App",
  "tech_stack": {
    "frontend": "React",
    "backend": "FastAPI",
    "database": "SQLite"
  },
  "models": {
    "User": {
      "id": "int primary key",
      "email": "str unique",
      "hashed_password": "str",
      "created_at": "datetime"
    }
  },
  "testing_strategy": {
    "backend": "pytest",
    "frontend": "jest",
    "e2e": "playwright"
  },
  "rules": [
    "Always use type hints",
    "No hardcoded secrets",
    "Use BEM naming for CSS"
  ]
}
